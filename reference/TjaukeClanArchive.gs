  members:{title:'Hunters',sheet:'Members',prefix:'MEM',fields:[f('name','Yautja name','text',{required:true}),f('epithet','Epithet / interpretation'),f('player','Player / Discord'),f('rank','Rank','select',{options:TK.ranks.map(r=>r[0]),required:true}),f('house','Agaj’ya / household','ref',{ref:'houses'}),f('sponsor','Nrak’ytara / sponsor','ref',{ref:'members'}),f('status','Standing','select',{options:['Active','On leave','Missing','Deceased','Departed'],required:true}),f('joined','Joined','date'),f('biography','Life and character','textarea'),f('appearance','Appearance and equipment','textarea'),f('hooks','Unfinished business / RP hooks','textarea'),f('source','Profile / reference URL','url')]},
  houses:{title:'Households',sheet:'Households',prefix:'HSE',fields:[f('name','Agaj’ya name','text',{required:true}),f('meaning','Estimated meaning'),f('senior','Household senior','ref',{ref:'members'}),f('vessel','Vessel / holding'),f('status','Condition','select',{options:['Active','Dispersed','Dissolved'],required:true}),f('history','History and obligations','textarea'),f('identity','Customs / material identity','textarea')]},
  hunts:{title:'Hunt ledger',sheet:'Hunts',prefix:'HNT',fields:[f('name','Account title','text',{required:true}),f('hunter','Hunter','ref',{ref:'members',required:true}),f('witness','Hult’ah / witness','ref',{ref:'members'}),f('date','Real-world session date','date'),f('era','In-character date / expedition'),f('quarry','Identified quarry','textarea',{required:true}),f('weapon','Declared weapons','textarea',{required:true}),f('limits','Additional restrictions','textarea'),f('state','Undertaking','select',{options:['Planned','Declared','Completed','Withdrawn','Invalidated'],required:true}),f('outside','Outside contribution','select',{options:['Unknown','No','Yes'],required:true}),f('review','Claim judgment','select',{options:['Pending','Accepted','Rejected'],required:true}),f('trophy','Claimed trophy'),f('account','Returned account','textarea'),f('judgment','Judgment / grounds','textarea'),f('source','Evidence URL','url')]},
  chronicle:{title:'Clan chronicle',sheet:'History',prefix:'HIS',fields:[f('name','Entry title','text',{required:true}),f('era','In-character date / era'),f('order','Reading order','number',{required:true}),f('date','Recorded date','date'),f('category','Category','select',{options:['Origins','Expedition','Succession','Judgment','Loss','Treaty','Personal account','Other'],required:true}),f('member','Related hunter','ref',{ref:'members'}),f('house','Related household','ref',{ref:'houses'}),f('hunt','Related hunt','ref',{ref:'hunts'}),f('certainty','Evidence','select',{options:['Recorded','Corroborated','Reconstructed','Disputed','Oral tradition'],required:true}),f('summary','Opening summary','textarea'),f('body','Full account','textarea',{required:true}),f('source','Source URL','url')]},
  duties:{title:'Duties',sheet:'Duties',prefix:'DUT',fields:[f('name','Duty / office','text',{required:true}),f('member','Holder','ref',{ref:'members',required:true}),f('house','Scope / household','ref',{ref:'houses'}),f('start','From','date'),f('end','Until','date'),f('status','Appointment','select',{options:['Active','Acting','Ended'],required:true}),f('mandate','Mandate and limits','textarea',{required:true})]},
  library:{title:'Documents',sheet:'Library',prefix:'DOC',fields:[f('name','Document / chapter','text',{required:true}),f('category','Shelf','select',{options:['Clan dossier','Reference','Language','Play rules','External document'],required:true}),f('order','Reading order','number',{required:true}),f('summary','Abstract','textarea'),f('body','Document text','textarea',{hidden:true}),f('url','Document URL','url',{required:true})]},
  settings:{title:'Configuration',sheet:'Settings',prefix:'CFG',fields:[f('name','Clan name','text',{required:true}),f('subtitle','Subtitle'),f('welcome','Archive introduction','textarea'),f('dossierUrl','Published Weyland-Yutani dossier URL','url'),f('rulesUrl','CMU / honour code URL','url')]}
};}
function onOpen(){SpreadsheetApp.getUi().createMenu('Tjau’ke Archive').addItem('Dashboard & Politics','showTjaukeCanvas').addItem('Refresh politics','refreshTjaukePolitics').addItem('Administration / edit records','openTjaukeHQ').addSeparator().addItem('Install / repair archive','installTjauke').addItem('Validate records','validateTjauke').addItem('Show background tabs','showTjaukeData').addItem('Hide background tabs','hideTjaukeData').addToUi();}
function tkSS_(){const ss=SpreadsheetApp.getActiveSpreadsheet();if(!ss)throw Error('Use this script bound to a Google Sheet.');return ss;}
function tkLock_(fn){const lock=LockService.getDocumentLock();if(!lock)throw Error('Open the bound spreadsheet first.');lock.waitLock(20000);try{return fn();}finally{lock.releaseLock();}}
function tkSheet_(name){const s=tkSS_().getSheetByName(TK.prefix+name);if(!s)throw Error('Run installTjauke first; missing '+name);return s;}
function tkHeaders_(schema){return ['ID'].concat(schema.fields.map(f=>f.label),['Archived','Created at','Updated at','Request ID']);}
function tkCheck_(sh,headers){const found=sh.getRange(1,1,1,headers.length).getDisplayValues()[0];if(found.join('\t')!==headers.join('\t'))throw Error('Schema mismatch on '+sh.getName()+'. Restore its original header row; no data was overwritten.');}
function tkReady_(){if(PropertiesService.getDocumentProperties().getProperty(TK.marker)!=='true')throw Error('Run installTjauke in this spreadsheet first.');}
function tkText_(v){return v===null||v===undefined?'':String(v);}
function tkCell_(v){const s=tkText_(v);return /^[=+@-]/.test(s)?"'"+s:s;}
function tkUrl_(v){return !v||/^https?:\/\/[^\s<>"']+$/i.test(v);}
function tkToken_(record){return Utilities.base64EncodeWebSafe(Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,JSON.stringify(record))).slice(0,32);}
function tkRecords_(type){const sc=tkSchemas_()[type];if(!sc)throw Error('Unknown record type.');const sh=tkSheet_(sc.sheet);tkCheck_(sh,tkHeaders_(sc));if(sh.getLastRow()<2)return [];
  return sh.getRange(2,1,sh.getLastRow()-1,sc.fields.length+5).getValues().filter(r=>r.some(v=>v!=='')).map(r=>{
    const o={id:tkText_(r[0])};sc.fields.forEach((f,i)=>{const v=r[i+1];o[f.key]=v instanceof Date?Utilities.formatDate(v,tkSS_().getSpreadsheetTimeZone(),'yyyy-MM-dd'):tkText_(v);});
    const n=sc.fields.length;o.archived=r[n+1]===true||String(r[n+1]).toLowerCase()==='true';o.created=tkText_(r[n+2]);o.updated=tkText_(r[n+3]);o.requestId=tkText_(r[n+4]);o.token=tkToken_(o);return o;
  });}
function tkData_(){const data={};Object.keys(tkSchemas_()).forEach(t=>data[t]=tkRecords_(t));return data;}
function tkPublic_(d){return {version:TK.version,schemas:tkSchemas_(),ranks:TK.ranks,data:d,url:tkSS_().getUrl()};}
function tkBootstrap(){tkReady_();return tkLock_(()=>tkPublic_(tkData_()));}
function tkAudit_(action,type,id,before,after,reason){const sh=tkSheet_('Audit');sh.appendRow([new Date().toISOString(),tkCell_(Session.getActiveUser().getEmail()||'Identity unavailable'),action,type,id,tkCell_(reason),tkCell_(JSON.stringify(before||{})),tkCell_(JSON.stringify(after||{}))]);}
function tkWrite_(type,o,row){const sc=tkSchemas_()[type];const sh=tkSheet_(sc.sheet);const vals=[o.id].concat(sc.fields.map(f=>tkCell_(o[f.key])),[o.archived===true,o.created,o.updated,o.requestId]);const at=row||sh.getLastRow()+1;if(at>sh.getMaxRows())sh.insertRowsAfter(sh.getMaxRows(),100);sh.getRange(at,1,1,vals.length).setValues([vals]);}
function tkValidateRecord_(type,o,all,old,reason){const sc=tkSchemas_()[type];if(!sc)throw Error('Unknown record type.');sc.fields.forEach(f=>{
    const v=tkText_(o[f.key]).trim();if(f.required&&!v)throw Error(f.label+' is required.');if(v.length>28000)throw Error(f.label+' exceeds 28,000 characters. Split the account into chapters.');
    if(v&&f.type==='select'&&!f.options.includes(v))throw Error('Invalid '+f.label+'.');
    if(v&&f.type==='number'&&!Number.isFinite(Number(v)))throw Error(f.label+' must be numeric.');
    if(v&&f.type==='date'&&(!/^\d{4}-\d{2}-\d{2}$/.test(v)||!Number.isFinite(Date.parse(v+'T12:00:00Z'))||new Date(v+'T12:00:00Z').toISOString().slice(0,10)!==v))throw Error('Invalid '+f.label+'.');
    if(f.type==='url'&&!tkUrl_(v))throw Error(f.label+' must be an http(s) URL.');
    if(v&&f.type==='ref'){const ref=all[f.ref].find(x=>x.id===v);if(!ref)throw Error(f.label+' refers to a missing record.');if(ref.archived&&(!old||old[f.key]!==v))throw Error(f.label+' is archived.');}
  });
  if(JSON.stringify(o).length>43000)throw Error('This record is too large for an auditable Sheets row. Split it into linked chapters.');
  if(type==='clans'){
    if(o.id==='CLN-SELF'&&(o.archived||o.kind!=='Yautja clan'))throw Error('The home clan must remain an active Yautja affiliation.');
    if(!o.archived&&all.clans.some(x=>!x.archived&&x.id!==o.id&&x.name.toLowerCase()===o.name.toLowerCase()))throw Error('An affiliation with this name already exists.');
  }
  if(type==='relations'){
    if(o.from===o.to)throw Error('An affiliation cannot have a political relation with itself.');
    if(!o.archived&&all.relations.some(x=>!x.archived&&x.id!==o.id&&x.from===o.from&&x.to===o.to))throw Error('This directional relation already exists. Edit its existing assessment.');
  }
  if(type==='settings'&&!old&&all.settings.length)throw Error('Edit the existing configuration record.');
  if(type==='members'){
    if(o.sponsor&&o.sponsor===o.id)throw Error('A hunter cannot sponsor themselves.');
    let cursor=o.sponsor, seen=new Set([o.id]);while(cursor){if(seen.has(cursor))throw Error('Sponsor cycle detected.');seen.add(cursor);const p=all.members.find(x=>x.id===cursor);cursor=p?p.sponsor:'';}
    if(o.rank==='Leader'&&o.status==='Active'&&!o.archived&&all.members.some(x=>x.id!==o.id&&!x.archived&&x.rank==='Leader'&&x.status==='Active'))throw Error('An active Leader already exists. Record the succession first.');
    if(old&&old.rank!==o.rank&&!reason)throw Error('Explain the rank change in the change reason.');
  }
  if(type==='duties'&&o.start&&o.end&&o.end<o.start)throw Error('End date precedes start date.');
  if(type==='hunts'){
    if(o.hunter===o.witness)throw Error('Hunter and witness must be different members.');
    if(!old&&o.state!=='Planned')throw Error('Create a planned undertaking, then declare it.');
    if(old){const transitions={Planned:['Planned','Declared'],Declared:['Declared','Completed','Withdrawn','Invalidated'],Completed:['Completed','Invalidated'],Withdrawn:['Withdrawn'],Invalidated:['Invalidated']};if(!transitions[old.state]||!transitions[old.state].includes(o.state))throw Error('That undertaking cannot return to an earlier state.');
      if(old.state!=='Planned'&&['hunter','witness','quarry','weapon','limits'].some(k=>o[k]!==old[k]))throw Error('Declared terms are sealed. Record corrections in the account; do not rewrite the oath.');
      if(old.review!==o.review&&(!reason||!o.judgment))throw Error('A claim decision requires judgment text and a change reason.');
    }
    if(['Completed','Withdrawn','Invalidated'].includes(o.state)&&!o.account.trim())throw Error('Closing an undertaking requires a returned account.');
    if(o.review==='Accepted'&&(o.state!=='Completed'||o.outside!=='No'||!o.account.trim()||!o.judgment.trim()))throw Error('Acceptance requires a completed hunt, no outside contribution, account and judgment.');
    if(o.state==='Planned'&&o.review!=='Pending')throw Error('A planned hunt cannot already be judged.');
  }
}
function tkSave(payload){tkReady_();return tkLock_(()=>{
  const p=payload||{}, sc=tkSchemas_()[p.type];if(!sc)throw Error('Unknown record type.');if(!p.values||typeof p.values!=='object')throw Error('Missing values.');
  const all=tkData_(), rows=all[p.type];const old=p.id?rows.find(x=>x.id===p.id):null;if(p.id&&!old)throw Error('Record no longer exists.');
  if(old&&old.token!==p.token)throw Error('Someone changed this record. Reload before saving; your changes were not written.');
  if(!old&&!/^[a-zA-Z0-9_-]{8,100}$/.test(p.requestId||''))throw Error('Missing save request identifier.');
  const retry=!old&&rows.find(x=>x.requestId===p.requestId);if(retry){if(sc.fields.every(f=>tkText_(p.values[f.key]).trim()===retry[f.key]))return {ok:true,id:retry.id};throw Error('This save request was already used. Reopen the editor.');}
  const now=new Date().toISOString();const o={id:old?old.id:sc.prefix+'-'+Utilities.getUuid().slice(0,12).toUpperCase(),created:old?old.created:now,updated:now,archived:old?old.archived:false,requestId:old?old.requestId:p.requestId};
  sc.fields.forEach(f=>o[f.key]=tkText_(p.values[f.key]).trim());const reason=tkText_(p.reason).trim();tkValidateRecord_(p.type,o,all,old,reason);
  const row=old?tkSheet_(sc.sheet).getRange(2,1,tkSheet_(sc.sheet).getLastRow()-1,1).getDisplayValues().findIndex(x=>x[0]===old.id)+2:null;
  // Record intent first; a failed sheet write leaves an explicit incomplete attempt.
  tkAudit_('SAVE_INTENT',p.type,o.id,old,o,reason);tkWrite_(p.type,o,row);tkAudit_('SAVED',p.type,o.id,{}, {},reason);
  PropertiesService.getDocumentProperties().setProperty('TK_DIRTY','true');const warning=['clans','relations','settings'].includes(p.type)?tkPoliticsUpdate_():'';return {ok:true,id:o.id,warning:warning};
});}
function tkArchive(payload){tkReady_();return tkLock_(()=>{const p=payload||{};if(p.type==='settings')throw Error('Configuration cannot be archived.');const sc=tkSchemas_()[p.type];if(!sc)throw Error('Unknown type.');const all=tkData_(),o=all[p.type].find(x=>x.id===p.id);if(!o||o.token!==p.token)throw Error('Record changed or missing. Reload first.');if(!tkText_(p.reason).trim())throw Error('Give a reason.');const before=Object.assign({},o);o.archived=!o.archived;o.updated=new Date().toISOString();tkValidateRecord_(p.type,o,all,before,p.reason);const sh=tkSheet_(sc.sheet),row=sh.getRange(2,1,sh.getLastRow()-1,1).getDisplayValues().findIndex(x=>x[0]===o.id)+2;tkAudit_('ARCHIVE_INTENT',p.type,o.id,before,o,p.reason);tkWrite_(p.type,o,row);tkAudit_(o.archived?'ARCHIVED':'RESTORED',p.type,o.id,{}, {},p.reason);PropertiesService.getDocumentProperties().setProperty('TK_DIRTY','true');const warning=['clans','relations'].includes(p.type)?tkPoliticsUpdate_():'';return {ok:true,warning:warning};});}
function tkAuditFor(payload){tkReady_();const id=tkText_((payload||{}).id),sh=tkSheet_('Audit');if(sh.getLastRow()<2)return [];return sh.getRange(2,1,sh.getLastRow()-1,8).getDisplayValues().filter(r=>r[4]===id).slice(-100).reverse().map(r=>({date:r[0],actor:r[1],action:r[2],reason:r[5],before:r[6],after:r[7]}));}
function tkEnsureSize_(sh,rows,cols){if(sh.getMaxRows()<rows)sh.insertRowsAfter(sh.getMaxRows(),rows-sh.getMaxRows());if(sh.getMaxColumns()<cols)sh.insertColumnsAfter(sh.getMaxColumns(),cols-sh.getMaxColumns());}
function tkSetupTable_(name,headers){const ss=tkSS_(),sh=ss.getSheetByName(TK.prefix+name)||ss.insertSheet(TK.prefix+name);tkEnsureSize_(sh,200,headers.length);if(sh.getLastRow()===0)sh.getRange(1,1,1,headers.length).setValues([headers]);tkCheck_(sh,headers);sh.getRange(1,1,sh.getMaxRows(),sh.getMaxColumns()).clearFormat();sh.setFrozenRows(1);sh.setHiddenGridlines(false);sh.setTabColor(null);sh.setRowHeights(1,sh.getMaxRows(),21);sh.setColumnWidths(1,headers.length,150);sh.getRange(1,1,1,headers.length).setFontWeight('bold');sh.getRange(2,1,sh.getMaxRows()-1,headers.length).setNumberFormat('@');return sh;}
function installTjauke(){const result=tkLock_(()=>{
  const ss=tkSS_(),schemas=tkSchemas_(),props=PropertiesService.getDocumentProperties(),installed=['true','installing'].includes(props.getProperty(TK.marker));
  const names=TK.views.concat(Object.values(schemas).map(s=>s.sheet),['Audit']);
  if(ss.getSheetByName(TK.politics)&&props.getProperty('TK_POLITICS_OWNED')!=='true')throw Error('A Politics sheet already exists and is not owned by this script. Rename it before installing; its contents were preserved.');
  // Preflight every collision before creating or changing any sheet.
  names.forEach(n=>{const sh=ss.getSheetByName(TK.prefix+n);if(sh&&!installed)throw Error('A sheet already uses '+TK.prefix+n+'. Install in a fresh workbook; existing data was not modified.');});
  if(installed)Object.values(schemas).forEach(sc=>{const sh=ss.getSheetByName(TK.prefix+sc.sheet);if(sh&&sh.getLastRow()>0)tkCheck_(sh,tkHeaders_(sc));});
  if(installed&&ss.getSheetByName(TK.prefix+'Audit')&&tkSheet_('Audit').getLastRow()>0)tkCheck_(tkSheet_('Audit'),['Timestamp','Actor','Action','Type','Record ID','Reason','Before','After']);
  props.setProperty(TK.marker,'installing');
  Object.keys(schemas).forEach(t=>{const sc=schemas[t],sh=tkSetupTable_(sc.sheet,tkHeaders_(sc));sc.fields.forEach((f,i)=>{if(f.type==='select')sh.getRange(2,i+2,sh.getMaxRows()-1,1).setDataValidation(SpreadsheetApp.newDataValidation().requireValueInList(f.options,true).setAllowInvalid(false).build());});});
  tkSetupTable_('Audit',['Timestamp','Actor','Action','Type','Record ID','Reason','Before','After']);
  if(installed&&ss.getSheetByName(TK.prefix+'Dossier')&&!ss.getSheetByName(TK.prefix+'Documents'))ss.getSheetByName(TK.prefix+'Dossier').setName(TK.prefix+'Documents');
  // Older generated views are retained for reference, but never rebuilt.
  TK.views.concat(['Dossier']).forEach(n=>{const sh=ss.getSheetByName(TK.prefix+n);if(!sh)return;sh.getRange(1,1,sh.getMaxRows(),sh.getMaxColumns()).breakApart().clearFormat();sh.setFrozenRows(0);sh.setFrozenColumns(0);sh.setRowHeights(1,sh.getMaxRows(),21);sh.setColumnWidths(1,sh.getMaxColumns(),100);sh.setTabColor(null);});
  tkCanvas_();
  props.setProperty('TK_POLITICS_OWNED','true');
  if(!ss.getSheetByName(TK.politics))ss.insertSheet(TK.politics);
  const now=new Date().toISOString();if(!tkRecords_('settings').length)tkWrite_('settings',{id:'CFG-CLAN',name:'Tjau’ke',subtitle:'CLAN ARCHIVE / MUSTER & MEMORY',welcome:'An ancient affiliation, its living members, and the accounts they leave behind. Read the history. Know the undertaking. Preserve what was actually earned.',dossierUrl:'',rulesUrl:'https://forum.cm-ss13.com/t/predator-honor-code/575',created:now,updated:now,requestId:'seed-settings',archived:false});
  if(!tkRecords_('clans').some(x=>x.id==='CLN-SELF'))tkWrite_('clans',{id:'CLN-SELF',name:tkRecords_('settings')[0].name,kind:'Yautja clan',notes:'Home clan. Its displayed name follows Configuration.',source:'',created:now,updated:now,requestId:'seed-home-clan',archived:false});
  props.setProperty(TK.marker,'true');props.setProperty('TK_VERSION',TK.version);tkRefresh_();return 'Dashboard mode installed. Dashboard and Politics are visible. Reload the Sheet; Manage records is available in the Tjau’ke Archive menu.';
});SpreadsheetApp.getUi().alert(result);}
/** Reserved for Gemini's presentation. Existing Canvas content is never changed.
 * This is a spreadsheet tab, not an embedded Gemini Canvas app. The independently
 * generated interface must connect to this bound script to use its record APIs.
 * tkBootstrap/tkSave/tkArchive remain available to bound HtmlService clients.
 */
function tkCanvas_(){const ss=tkSS_();let sh=ss.getSheetByName(TK.canvas);if(!sh){sh=ss.getSheetByName('Canvas');if(sh)sh.setName(TK.canvas);else {sh=ss.insertSheet(TK.canvas);sh.setHiddenGridlines(true);}}return sh;}
function showTjaukeCanvas(){tkReady_();tkLock_(()=>tkVisibility_(false));}
// Compatibility entry point for earlier clients: no generated views or Canvas writes.
function tkRefresh_(){tkRenderPolitics_();tkVisibility_(false);SpreadsheetApp.flush();}
function ssLink_(sh){return tkSS_().getUrl()+'#gid='+sh.getSheetId();}
function tkName_(rows,id){return (rows.find(x=>x.id===id)||{}).name||id||'Unaffiliated';}
function tkNative_(rank){return (TK.ranks.find(r=>r[0]===rank)||[rank,rank])[1];}
function tkRankIndex_(rank){return TK.ranks.findIndex(r=>r[0]===rank);}
function refreshTjauke(){tkReady_();tkLock_(tkRefresh_);tkSS_().toast('Dashboard and Politics are visible.','Tjau’ke');}
function tkRefreshViews(){tkReady_();tkLock_(tkRefresh_);return {ok:true};}
function onEdit(e){if(!e||!e.range)return;if(e.range.getSheet().getName().startsWith(TK.prefix)&&!TK.views.includes(e.range.getSheet().getName().slice(TK.prefix.length)))PropertiesService.getDocumentProperties().setProperty('TK_DIRTY','true');}
function tkVisibility_(show){tkReady_();const ss=tkSS_(),canvas=tkCanvas_();canvas.showSheet();canvas.activate();ss.getSheets().forEach(sh=>{if(sh.getSheetId()===canvas.getSheetId())return;if(sh.getName()===TK.politics){sh.showSheet();return;}if(show)sh.showSheet();else sh.hideSheet();});}
function showTjaukeData(){tkVisibility_(true);}
function hideTjaukeData(){tkVisibility_(false);}
function tkValidate(){tkReady_();return tkLock_(()=>{const d=tkData_(),issues=[];Object.keys(d).forEach(t=>{const ids=new Set();d[t].forEach(o=>{if(t==='library'&&o.requestId.startsWith('seed-DOC-DOSSIER-')&&!o.url)return;if(!o.id||ids.has(o.id))issues.push(t+': missing or duplicate ID '+o.id);ids.add(o.id);try{tkValidateRecord_(t,o,d,o,'validation');}catch(e){issues.push(o.id+': '+e.message);}});});return {issues:issues,records:Object.values(d).reduce((n,r)=>n+r.length,0)};});}
function validateTjauke(){const r=tkValidate();SpreadsheetApp.getUi().alert(r.issues.length?r.issues.join('\n'):'All '+r.records+' records passed validation.');}
function openTjaukeHQ(){tkReady_();SpreadsheetApp.getUi().showModalDialog(HtmlService.createHtmlOutput(tkHtml_()).setWidth(1180).setHeight(820),'Tjau’ke / Administration');}

// Politics is a generated view; edit its source records through Manage records.
function tkPoliticsStyle_(){return {Unknown:['#e5e7eb','#374151'],Allied:['#285943','#ffffff'],Friendly:['#b8d8bd','#183b27'],Neutral:['#ece5d3','#514a37'],Rival:['#e8c775','#523b12'],Hostile:['#b65b49','#ffffff'],War:['#6f252a','#ffffff']};}
function tkPoliticsRows_(data,kind){return data.clans.filter(x=>!x.archived&&x.kind===kind).map(x=>Object.assign({},x,{name:x.id==='CLN-SELF'?data.settings[0].name:x.name})).sort((a,b)=>(a.id==='CLN-SELF'?-1:b.id==='CLN-SELF'?1:a.name.localeCompare(b.name)));}
function tkRenderPolitics_(){
  const ss=tkSS_(),d=tkData_(),sh=ss.getSheetByName(TK.politics)||ss.insertSheet(TK.politics),colors=tkPoliticsStyle_();
  const clans=tkPoliticsRows_(d,'Yautja clan'),outsiders=tkPoliticsRows_(d,'Outsider faction'),all=clans.concat(outsiders),relations=d.relations.filter(x=>!x.archived);
  const outsiderStart=clans.length+15,rows=outsiderStart+all.length+5,cols=Math.max(4,all.length+1);
  tkEnsureSize_(sh,rows,cols);sh.getRange(1,1,Math.max(rows,sh.getLastRow()),Math.max(cols,sh.getLastColumn())).breakApart().clear();
  sh.setHiddenGridlines(true);sh.setFrozenRows(1);sh.setFrozenColumns(1);sh.setTabColor('#b65b49');sh.setColumnWidth(1,210);sh.setColumnWidths(2,cols-1,145);sh.setRowHeights(1,rows,42);
  function matrix(top,entities,external){
    const n=entities.length+1,values=Array.from({length:n},()=>Array(n).fill('')),bg=values.map(r=>r.map(()=> '#ffffff')),fg=values.map(r=>r.map(()=> '#27342b')),notes=values.map(r=>r.map(()=>''));
    values[0][0]=external?'OUTSIDERS · row → column':'CLANS · row → column';
    entities.forEach((x,i)=>{values[0][i+1]=tkCell_(x.name);values[i+1][0]=tkCell_(x.name);});
    entities.forEach((a,i)=>entities.forEach((b,j)=>{
      let label='Unknown',note='No stance recorded. Unknown does not imply neutrality.';
      if(a.id===b.id){label='—';note='Same affiliation.';}
      else if(external&&a.kind==='Yautja clan'&&b.kind==='Yautja clan'){label='See clan matrix';note='Clan-to-clan relations are shown above.';}
      else {const r=relations.find(r=>r.from===a.id&&r.to===b.id);if(r){label=r.stance;note=[a.name+' → '+b.name,r.notes,r.source?'Source: '+r.source:'',r.updated?'Updated: '+r.updated:''].filter(Boolean).join('\n');}}
      const style=colors[label]||['#f3f4f6','#6b7280'];values[i+1][j+1]=label;bg[i+1][j+1]=style[0];fg[i+1][j+1]=style[1];notes[i+1][j+1]=note;
    }));
    for(let i=0;i<n;i++){bg[0][i]=bg[i][0]='#202b26';fg[0][i]=fg[i][0]='#ffffff';}
    sh.getRange(top,1,n,n).setValues(values).setBackgrounds(bg).setFontColors(fg).setNotes(notes).setWrap(true).setVerticalAlignment('middle').setHorizontalAlignment('center').setFontFamily('Arial').setFontSize(10);
    sh.getRange(top,1,1,n).setFontWeight('bold');sh.getRange(top,1,n,1).setFontWeight('bold');
  }
  matrix(1,clans,false);
  let row=clans.length+3;
  sh.getRange(row++,2,1,3).merge().setValue('ROW → COLUMN: stances are directional; the reverse is recorded separately.').setWrap(true);
  sh.getRange(row++,2,1,3).merge().setValue('Edit in Tjau’ke Archive → Administration / edit records → Politics. Cell notes hold context and sources.').setWrap(true);
  Object.keys(colors).forEach(k=>{sh.getRange(row,1).setValue(k).setBackground(colors[k][0]).setFontColor(colors[k][1]);sh.setRowHeight(row++,25);});
  sh.getRange(row,2,1,3).merge().setRichTextValue(SpreadsheetApp.newRichTextValue().setText('CMU faction relations reference ↗').setLinkUrl(TK.factionReference).build());
  if(outsiders.length)matrix(outsiderStart,all,true);
  else sh.getRange(outsiderStart,2,2,3).merge().setValue('OUTSIDER FACTIONS\nNo outsiders registered. Add them in Politics when needed; no faction relations have been assumed.').setWrap(true);
  sh.showSheet();SpreadsheetApp.flush();
}
function tkPoliticsUpdate_(){try{tkRenderPolitics_();return '';}catch(e){PropertiesService.getDocumentProperties().setProperty('TK_POLITICS_DIRTY','true');return 'Record saved, but the Politics sheet could not refresh: '+e.message+'. Use Refresh politics in the menu.';}}
function refreshTjaukePolitics(){tkReady_();tkLock_(()=>{tkRenderPolitics_();PropertiesService.getDocumentProperties().deleteProperty('TK_POLITICS_DIRTY');});}

