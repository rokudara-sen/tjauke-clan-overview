function tkDashboardData(){tkReady_();return tkLock_(()=>{const all=tkData_(),data={};const schemas=tkSchemas_();Object.keys(schemas).forEach(type=>{data[type]=all[type].filter(x=>!x.archived).map(record=>{const row={id:record.id};schemas[type].fields.filter(f=>!f.hidden).forEach(f=>row[f.key]=record[f.key]);if(type==='clans'&&row.id==='CLN-SELF')row.name=all.settings[0].name;return row;});});return {version:TK.version,data:data,ranks:TK.ranks,politicsSheet:tkPoliticsSnapshot_(),links:{dashboard:ssLink_(tkCanvas_()),politics:ssLink_(tkSS_().getSheetByName(TK.politics)),factionReference:TK.factionReference}};});}


function tkPoliticsSnapshot_(){const sh=tkSS_().getSheetByName(TK.politics);if(!sh)return null;const rows=sh.getLastRow(),cols=sh.getLastColumn();if(!rows||!cols)return {values:[]};const r=sh.getRange(1,1,rows,cols);return {values:r.getDisplayValues(),backgrounds:r.getBackgrounds(),fontColors:r.getFontColors(),notes:r.getNotes()};}

