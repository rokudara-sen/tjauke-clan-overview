itrow{font:12px/1.5 Arial;border-bottom:1px solid var(--line);padding:12px 0}.auditrow details{margin-top:5px}.auditrow pre{max-height:180px;overflow:auto;white-space:pre-wrap;font-size:10px}dialog{border:1px solid #aeb7a0;padding:0;max-width:780px;width:calc(100% - 40px);max-height:90vh;background:var(--paper);color:var(--ink)}dialog::backdrop{background:#111d17bb}.dialoghead{padding:20px 24px;background:var(--panel);color:var(--bone);display:flex;justify-content:space-between;align-items:center}.dialoghead h2{margin:0}.dialoghead button{color:var(--bone);background:none;border:0}.formbody{padding:24px;overflow:auto;max-height:65vh}.fields{display:grid;grid-template-columns:1fr 1fr;gap:18px}.field.full{grid-column:1/-1}.field label{display:block;font-size:12px;margin-bottom:6px;color:#58644f}.field input,.field select,.field textarea{width:100%;border:1px solid #bdc5b0;padding:10px;background:#fffdf7;color:var(--ink);border-radius:2px}.field textarea{min-height:115px;resize:vertical}.field textarea:disabled,.field input:disabled,.field select:disabled{background:#e9ebdf;color:#68755e}.field small{color:var(--muted)}.formerror{color:#99391e;background:#f3e1d7;padding:10px 14px;margin-bottom:12px;display:none}.dialogfoot{display:flex;gap:9px;justify-content:flex-end;padding:15px 24px;border-top:1px solid var(--line)}#toast{position:fixed;bottom:20px;right:20px;background:#203128;color:#eef2db;padding:13px 20px;max-width:500px;z-index:9;display:none;box-shadow:0 5px 25px #0003}.loading{padding:60px;text-align:center;color:var(--muted)}.preview{background:#f2dfbd;color:#654b2c;text-align:center;font-size:11px;padding:5px}.error{padding:30px;background:#f2ddd4;color:#843e2b}button.link{background:none;border:0;padding:0;color:#526944;text-align:left}.nowrap{white-space:nowrap}@media(max-width:850px){.shell{grid-template-columns:160px 1fr}.sidebar{padding:20px 10px}.brand{font-size:23px}main{padding:22px}.topbar{padding:0 20px}.hero{grid-template-columns:1fr;padding:25px