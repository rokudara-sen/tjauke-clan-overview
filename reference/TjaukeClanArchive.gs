cel</button><button type=\"submit\" class=\"primary\" id=\"save\">Save record</button></div></form></dialog><div id=\"toast\" role=\"status\" aria-live=\"polite\"></div>\n<script>\n'use strict';\nlet DATA=null,PAGE='overview',QUERY='',INCLUDE_ARCHIVED=false,PROFILE='',READING='',EDIT=null,BUSY=false;\nconst NAV=[['overview','Clan overview'],['politics','Politics'],['members','Hunters'],['chronicle','Chronicle'],['hunts','Undertakings'],['houses','Households'],['duties','Duties'],['library','Documents'],['ranks','Rank register'],['settings','Configuration']];\nconst $=id=>document.getElementById(id);\nconst esc=x=>String(x==null?'':x).replace(/[&<>\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]));\nconst urlOK=x=>/^https?:\\/\\/[^\\s<>\"']+$/i.test(x||'');\nconst link=(url,label)=>urlOK(url)?'<a rel=\"noopener noreferrer\" target=\"_blank\" href=\"'+esc(url)+'\">'+esc(label||'Open reference ↗')+'</a>':'';\nconst clip=(s,n)=>String(s||'').length>n?String(s).slice(0,n)+'…':String(s||'');\nconst native=r=>(DATA.ranks.find(x=>x[0]===r)||[r,r])[1];\nconst rows=t=>(DATA.data[t]||[]).filter(x=>INCLUDE_ARCHIVED||!x.archived);\nconst name=(t,id)=>((DATA.data[t]||[]).find(x=>x.id===id)||{}).name||id||'Unaffiliated';\nconst badge=(s,bad)=>'<span class=\"pill '+(bad?'rust':'')+'\">'+esc(s)+'</span>';\nconst btn=(action,type,id,label,cl)=>'<button class=\"'+(cl||'small')+'\" data-action=\"'+action+'\" data-type=\"'+esc(type||'')+'\" data-id=\"'+esc(id||'')+'\">'+esc(label)+'</button>';\nfunction toast(s){$('toast').textContent=s;$('toast').style.display='block';setTimeout(()=>$('toast').style.display='none',6500);}\nfunction rpc(method,payload){if(window.TK_PREVIEW)return previewRPC(method,payload);return new Promise((resolve,reject)=>{const runner=google.script.run.withSuccessHandler(resolve).withFailureHandler(e=>reject(Error(e.message||e)));if(payload===undefined)runner[method]();else runner[method](payload);});}\nasync function load(){try{DATA=await rpc('tkBootstrap');$('version').textContent='VERSION '+DATA.version;document.querySelector('.brand').textContent=DATA.data.settings[0].name;render();}catch(e){$('root').innerHTML='<div class=\"error\"><h2>Archive unavailable</h2><p>'+esc(e.message)+'</p><p>Run installTjauke once in Apps Script, then reload.</p></div>';}}\nfunction go(p){PAGE=p;PROFILE='';READING='';QUERY='';render();}\nfunction heading(title,sub,type){return '<div class=\"kicker\">TJAU’KE / '+esc(title)+'</div><div class=\"sectionhead\"><h1>'+esc(title)+'</h1>'+(type?btn('new',type,'','New record','primary'):'')+'</div><p class=\"intro\">'+esc(sub)+'</p>';}\nfunction empty(title,text){return '<div class=\"empty\"><h3>'+esc(title)+'</h3><p>'+esc(text)+'</p></div>';}\nfunction toolbar(){return '<div class=\"toolbar\"><input type=\"search\" id=\"search\" aria-label=\"Search records\" placeholder=\"Search names, accounts, places…\" value=\"'+esc(QUERY)+'\"><label><input type=\"checkbox\" id=\"archived\" '+(INCLUDE_ARCHIVED?'checked':'')+'> Include archived</label></div>';}\nfunction filtered(t){const q=QUERY.toLowerCase();return rows(t).filter(x=>!q||Object.values(x).join(' ').toLowerCase().includes(q));}\nfunction inline(s){let out=esc(s);out=out.replace(/\\[([^\\]]+)\\]\\((https?:\\/\\/[^\\s)]+)\\)/g,(_,label,url)=>'<a href=\"'+url+'\" target=\"_blank\" rel=\"noopener noreferrer\">'+label+'</a>');return out.replace(/\\*\\*([^*]+)\\*\\*/g,'<strong>$1</strong>').replace(/\\*([^*]+)\\*/g,'<em>$1</em>');}\nfunction prose(text){const lines=String(text||'').split(/\\r?\\n/);let out='',p=[],table=[],list=[];function flush(){if(p.length){out+='<p>'+inline(p.join('\\n'))+'</p>';p=[];}if(list.length){out+='<ul>'+list.map(x=>'<li>'+inline(x)+'</li>').join('')+'</ul>';list=[];}if(table.length){out+='<div style=\"overflow:auto\"><table>'+table.filter(x=>!/^\\|[\\s:|\\-]+\\|$/.test(x)).map((x,i)=>'<tr>'+x.replace(/^\\||\\|$/g,'').split('|').map(c=>'<'+(i?'td':'th')+'>'+inline(c.trim())+'</'+(i?'td':'th')+'>').join('')+'</tr>').join('')+'</table></div>';table=[];}}\n  lines.forEach(l=>{if(/^\\|/.test(l)){if(p.length||list.length)flush();table.push(l);return;}if(table.length)flush();if(!l.trim()){flush();return;}let m=l.match(/^(#{1,6})\\s+(.+)/);if(m){flush();let h=Math.min(3,m[1].length);out+='<h'+h+'>'+inline(m[2])+'</h'+h+'>';return;}if(/^---+$/.test(l)){flush();out+='<hr>';return;}if(/^>\\s?/.test(l)){flush();out+='<blockquote>'+inline(l.replace(/^>\\s?/,''))+'</blockquote>';return;}if(/^[-*]\\s/.test(l)){if(p.length)flush();list.push(l.slice(2));return;}if(list.length)flush();p.push(l);});flush();return '<div class=\"prose\">'+out+'</div>';}\nfunction overview(){const c=DATA.data.settings[0],m=DATA.data.members.filter(x=>!x.archived),h=DATA.data.hunts.filter(x=>!x.archived),hist=DATA.data.chronicle.filter(x=>!x.archived).sort((a,b)=>Number(b.order)-Number(a.order));let html='<div class=\"hero\"><div><div class=\"kicker\">Agaj’ya / An affiliation remembered</div><h1>'+esc(c.name)+'</h1><p>'+esc(c.welcome)+'</p>'+link(c.dossierUrl,'Weyland-Yutani dossier ↗')+'</div><div class=\"seal\">Yin’tekai<br>Kv’var<span>THE UNDERTAKING</span></div></div><div class=\"stats\">';\n  [['Active hunters',m.filter(x=>x.status==='Active').length],['Households',DATA.data.houses.filter(x=>!x.archived&&x.status==='Active').length],['Declared hunts',h.filter(x=>x.state==='Declared').length],['Chronicle entries',hist.length]].forEach(s=>html+='<div class=\"stat\"><span>'+s[0]+'</span><b>'+s[1]+'</b></div>');html+='</div><div class=\"columns\"><section><div class=\"sectionhead\"><h2>From the archive</h2>'+btn('nav','chronicle','','All accounts','link')+'</div>';\n  html+=hist.length?hist.slice(0,3).map(x=>chronicleCard(x)).join(''):empty('An unwritten chapter','Begin with the clan’s first player-authored account. Add Google Docs and reference links on the Documents page.');html+='</section><section><div class=\"sectionhead\"><h2>Before the hunt</h2></div><div class=\"card\"><div class=\"kicker\">Yin’tekai Kv’var</div><h3 style=\"margin-top:12px\">Declare. Witness. Account.</h3><p class=\"muted\">A harder fight does not change the terms. Outside contribution ends the exclusive claim.</p>'+btn('new','hunts','','Plan an undertaking','primary')+'</div><div class=\"card\"><div class=\"kicker\">CLAN DOCUMENTS</div><h3 style=\"margin-top:12px\">Lore & reference links</h3><p class=\"muted\">Keep the dossier, clan lore, and play rules one click away.</p>'+btn('nav','library','','Open documents','link')+'</div></section></div>';return html;}\nfunction memberCard(m){return '<article class=\"card\">'+badge(native(m.rank))+badge(m.status,m.status==='Deceased'||m.archived)+'<div class=\"name\">'+esc(m.name)+'</div><div class=\"muted\">'+esc(m.epithet||name('houses',m.house))+'</div><p style=\"margin-top:14px\">'+esc(clip(m.biography||'No biography recorded.',170))+'</p><div class=\"actions\">'+btn('profile','members',m.id,'Read life & record','primary')+btn('edit','members',m.id,'Edit')+'</div></article>';}\nfunction chronicleCard(x){return '<article class=\"entry\"><div class=\"meta\">'+esc(x.era||'Undated')+' / '+esc(x.category)+' / '+esc(x.certainty)+'</div><h3>'+esc(x.name)+'</h3><p>'+esc(clip(x.summary||x.body,220))+'</p><div class=\"actions\">'+btn('read','chronicle',x.id,'Read account','link')+btn('edit','chronicle',x.id,'Edit')+'</div></article>';}\nfunction huntCard(h){return '<article class=\"card\">'+badge(h.state)+badge(h.review,h.review==='Rejected')+(h.archived?badge('Archived',true):'')+'<h3 style=\"margin-top:8px\">'+esc(h.name)+'</h3><p class=\"muted\">'+esc(name('members',h.hunter))+' · '+esc(h.era||h.date||'Undated')+'</p><p><b>Quarry:</b> '+esc(clip(h.quarry,150))+'</p><p><b>Permitted:</b> '+esc(clip(h.weapon,100))+'</p><div class=\"actions\">'+btn('read','hunts',h.id,'Read undertaking','primary')+btn('edit','hunts',h.id,'Manage')+'</div></article>';}\nfunction collection(t){let title=DATA.schemas[t].title,sub={members:'Individuals, their standing, and the histories attached to them.',chronicle:'An ordered history. Reconstructed traditions and witnessed events remain distinguishable.',hunts:'Terms fixed before engagement; accounts and judgments recorded afterward.',houses:'Agaj’ya — inherited responsibilities, holdings, and dependants.',duties:'Appointments are responsibilities. They do not create additional ranks.'}[t]||'';let a=filtered(t);if(t==='chronicle')a.sort((x,y)=>Number(y.order)-Number(x.order));if(t==='members')a.sort((x,y)=>DATA.ranks.findIndex(r=>r[0]===y.rank)-DATA.ranks.findIndex(r=>r[0]===x.rank));\n  let html=heading(title,sub,t)+toolbar();if(!a.length)return html+empty('Nothing recorded here yet','Add a record or change the search. Archived records can be included above.');\n  if(t==='chronicle')return html+a.map(chronicleCard).join('');if(t==='members')return html+'<div class=\"cards\">'+a.map(memberCard).join('')+'</div>';if(t==='hunts')return html+'<div class=\"cards\">'+a.map(huntCard).join('')+'</div>';\n  return html+'<div class=\"cards\">'+a.map(x=>'<article class=\"card\">'+badge(x.stance||x.kind||x.status)+ (x.archived?badge('Archived',true):'')+'<h3>'+esc(x.name)+'</h3><p class=\"muted\">'+esc(t==='houses'?x.meaning:t==='clans'?x.kind:t==='relations'?name('clans',x.from)+' → '+name('clans',x.to):name('members',x.member))+'</p><p>'+esc(clip(x.history||x.mandate||x.notes,230))+'</p><div class=\"actions\">'+btn('read',t,x.id,'Read record')+btn('edit',t,x.id,'Edit')+'</div></article>').join('')+'</div>';}\nfunction readRecord(t,id){const x=DATA.data[t].find(x=>x.id===id);if(!x)return empty('Record missing','Reload the archive.');let content='';if(t==='chronicle')content=badge(x.certainty)+'<p class=\"muted\">'+esc(x.era)+' · '+esc(x.category)+'</p>'+prose(x.body)+(x.member?'<p>Related hunter: '+btn('profile','members',x.member,name('members',x.member),'link')+'</p>':'');else if(t==='hunts')content=badge(x.state)+badge(x.review)+'<p>Hunter: '+btn('profile','members',x.hunter,name('members',x.hunter),'link')+'</p>'+['quarry','weapon','limits','account','judgment','trophy'].map(k=>x[k]?'<h3>'+esc(DATA.schemas.hunts.fields.find(f=>f.key===k).label)+'</h3>'+prose(x[k]):'').join('')+'<p class=\"muted\">Outside contribution: '+esc(x.outside)+' · Witness: '+esc(x.witness?name('members',x.witness):'Not recorded')+'</p>';else content=DATA.schemas[t].fields.filter(f=>x[f.key]&&f.key!=='name'&&f.type!=='url').map(f=>'<h3>'+esc(f.label)+'</h3>'+prose(f.type==='ref'?name(f.ref,x[f.key]):x[f.key])).join('');return btn('back',t,'','← Back')+'<article class=\"reader\"><div class=\"reading-label\">'+esc(x.id)+'</div><h1>'+esc(x.name)+'</h1>'+content+link(x.source||x.url)+ '<div class=\"actions\" style=\"margin-top:25px\">'+btn('edit',t,id,'Edit record')+'</div></article>';}\nfunction profile(id){const m=DATA.data.members.find(x=>x.id===id);if(!m)return empty('Hunter missing','Reload the archive.');const hunts=DATA.data.hunts.filter(x=>x.hunter===id&&!x.archived),history=DATA.data.chronicle.filter(x=>x.member===id&&!x.archived),duties=DATA.data.duties.filter(x=>x.member===id&&!x.archived&&x.status!=='Ended');return btn('back','members','','← Muster')+'<div class=\"profilehead\"><div class=\"kicker\">'+esc(native(m.rank))+' / '+esc(m.rank)+'</div><h1>'+esc(m.name)+'</h1><p>'+esc(m.epithet||'')+'</p>'+badge(m.status)+badge(name('houses',m.house))+'</div><div class=\"columns\"><section><h2>The individual</h2>'+prose(m.biography||'No biography recorded.')+(m.appearance?'<h3>Appearance & equipment</h3>'+prose(m.appearance):'')+(m.hooks?'<h3>Unfinished business</h3>'+prose(m.hooks):'')+'<h2 style=\"margin-top:30px\">Recorded undertakings</h2>'+ (hunts.length?hunts.map(huntCard).join(''):empty('No undertakings','Hunts will be linked here automatically.'))+'<h2>In the chronicle</h2>'+history.map(chronicleCard).join('')+'</section><section><div class=\"card\"><h3>Standing & obligations</h3><p>Player: '+esc(m.player||'Not recorded')+'</p><p>Sponsor: '+esc(m.sponsor?name('members',m.sponsor):'Not recorded')+'</p>'+duties.map(x=>'<p>'+esc(x.name)+' — '+esc(x.status)+'</p>').join('')+link(m.source)+ '<div style=\"margin-top:15px\">'+btn('edit','members',id,'Edit hunter','primary')+'</div></div><div class=\"card\"><h3>Administrative history</h3><div id=\"auditPanel\">Loading change records…</div></div></section></div>';}\nfunction library(){const a=filtered('library').filter(x=>x.url).sort((x,y)=>Number(x.order)-Number(y.order));return heading('Documents','Paste Google Docs links with a title and short description. Documents open in a new tab.','library')+toolbar()+(a.length?'<div class=\"cards\">'+a.map(x=>'<article class=\"card\">'+badge(x.category)+'<h3>'+esc(x.name)+'</h3><p>'+esc(x.summary||'')+'</p><div class=\"actions\">'+link(x.url,'Open document ↗')+btn('edit','library',x.id,'Edit link')+'</div></article>').join('')+'</div>':empty('No documents linked yet','Choose New record, enter a title, and paste your Google Docs URL.'));}\nfunction ranksPage(){return heading('Rank register','Native-form titles precede the English game labels. The compounds and specialised rank uses are original Tjau’ke lore, with uncertain in-world interpretations.')+DATA.ranks.map((r,i)=>'<div class=\"rankrow\"><div class=\"ranknum\">0'+(i+1)+'</div><div><div class=\"kicker\">'+esc(r[0])+'</div><h3>'+esc(r[1])+'</h3><p>'+esc(r[2])+'</p><div class=\"muted\" style=\"font-size:12px\">Access '+esc(r[4])+' · Unique gear '+r[5]+' · Slot-cap exception '+r[6]+'</div></div></div>').join('');}\nfunction settings(){const c=DATA.data.settings[0];return heading('Configuration','Links and clan presentation. All workbook readers can access its stored records.')+'<div class=\"card\"><h2>'+esc(c.name)+'</h2><p>'+esc(c.subtitle)+'</p><p>'+esc(c.welcome)+'</p><p>'+ (link(c.dossierUrl,'Published dossier ↗')||'Published dossier URL: not set')+'</p><p>'+link(c.rulesUrl,'Honour code / play rules ↗')+'</p>'+btn('edit','settings',c.id,'Edit configuration','primary')+'</div><div class=\"notice\">Add document links under Documents, or feature one dossier URL here. Hidden tabs are organisation, not access control; keep private staff notes in another workbook.</div><div class=\"actions\">'+btn('validate','','','Validate database')+'</div><div id=\"validation\"></div>';}\nfunction render(){if(!DATA)return;$('nav').innerHTML=NAV.map(([p,label])=>btn('nav',p,'',label,PAGE===p?'active':'')).join('');$('breadcrumb').textContent=(NAV.find(x=>x[0]===PAGE)||[])[1]||'Clan archive';let html;if(PROFILE)html=profile(PROFILE);else if(READING&&PAGE!=='library')html=readRecord(PAGE,READING);else if(PAGE==='overview')html=overview();else if(PAGE==='politics')html=politics();else if(PAGE==='library')html=library();else if(PAGE==='ranks')html=ranksPage();else if(PAGE==='settings')html=settings();else html=collection(PAGE);$('root').innerHTML=html;if(PROFILE)loadAudit(PROFILE);}\nasync function loadAudit(id){try{const list=await rpc('tkAuditFor',{id});if(PROFILE!==id||!$('auditPanel'))return;$('auditPanel').innerHTML=list.length?list.map(x=>'<div class=\"auditrow\"><b>'+esc(x.action)+'</b><br>'+esc(x.date)+'<br>'+esc(x.reason||'No additional reason')+(x.action.endsWith('INTENT')?'<details><summary>Recorded change</summary><pre>'+esc(x.before)+'\\n→\\n'+esc(x.after)+'</pre></details>':'')+'</div>').join(''):'No changes recorded through HQ.';}catch(e){if($('auditPanel'))$('auditPanel').textContent=e.message;}}\nfunction defaults(t){const o={};DATA.schemas[t].fields.forEach(f=>o[f.key]=f.type==='select'?f.options[0]:f.type==='number'?'0':'');if(t==='members')o.status='Active';if(t==='hunts'){o.state='Planned';o.outside='Unknown';o.review='Pending';}return o;}\nfunction edit(t,id){const sc=DATA.schemas[t];const record=id?DATA.data[t].find(x=>x.id===id):null;if(id&&!record){toast('Record missing. Reload.');return;}EDIT={type:t,record,requestId:Date.now().toString(36)+'-'+Math.random().toString(36).slice(2)};const v=record||defaults(t);$('editorTitle').textContent=(id?'Edit ':'New ')+sc.title;$('formerror').style.display='none';$('formnote').innerHTML=t==='hunts'?'<div class=\"notice\">Create as Planned, then save as Declared. After declaration, quarry, hunter, witness, weapons and restrictions are sealed. Acceptance requires completion, no outside contribution, an account and judgment.</div>':'';\n  $('fields').innerHTML=sc.fields.filter(f=>!f.hidden).map(f=>{const val=v[f.key]||'',locked=t==='hunts'&&record&&record.state!=='Planned'&&['hunter','witness','quarry','weapon','limits'].includes(f.key);let attr=' name=\"'+f.key+'\" id=\"field-'+f.key+'\"'+(f.required?' required':'')+(locked?' disabled':'');let input;if(f.type==='textarea')input='<textarea'+attr+' maxlength=\"28000\">'+esc(val)+'</textarea>';else if(f.type==='select'||f.type==='ref'){let options=f.type==='ref'?[['','— None —']].concat(DATA.data[f.ref].filter(x=>!x.archived||x.id===val).map(x=>[x.id,x.name+(x.archived?' [archived]':'')])):f.options.map(x=>[x,f.key==='rank'?native(x)+' / '+x:x]);input='<select'+attr+'>'+options.map(([value,label])=>'<option value=\"'+esc(value)+'\" '+(val===value?'selected':'')+'>'+esc(label)+'</option>').join('')+'</select>';}else input='<input'+attr+' type=\"'+(['date','url','number'].includes(f.type)?f.type:'text')+'\" '+(f.type==='number'?'step=\"any\"':'')+' maxlength=\"28000\" value=\"'+esc(val)+'\">';return '<div class=\"field '+(f.type==='textarea'?'full':'')+'\"><label for=\"field-'+f.key+'\">'+esc(f.label)+(f.required?' *':'')+(locked?' · sealed':'')+'</label>'+input+'</div>';}).join('')+'<div class=\"field full\"><label for=\"reason\">Reason for change / judgment / rank action</label><textarea id=\"reason\" name=\"_reason\" placeholder=\"Required for rank changes, claim decisions, archiving or restoring.\"></textarea></div>';$('archive').style.display=id&&t!=='settings'?'':'none';$('archive').textContent=record&&record.archived?'Restore':'Archive';setBusy(false);$('editor').showModal();}\nfunction setBusy(v){BUSY=v;['save','archive','cancel','close'].forEach(id=>$(id).disabled=v);$('save').textContent=v?'Saving…':'Save record';}\nfunction formValues(){const values={};DATA.schemas[EDIT.type].fields.forEach(f=>values[f.key]=f.hidden?(EDIT.record?EDIT.record[f.key]||'':''):$('field-'+f.key).value);return values;}\nasync function save(e){e.preventDefault();if(BUSY)return;setBusy(true);const o=EDIT.record;try{const result=await rpc('tkSave',{type:EDIT.type,id:o?o.id:'',token:o?o.token:'',requestId:EDIT.requestId,values:formValues(),reason:$('reason').value});$('editor').close();toast(result.warning||'Record saved. Politics updated when applicable.');await load();}catch(e){$('formerror').textContent=e.message;$('formerror').style.display='block';}finally{setBusy(false);}}\nasync function archive(){if(BUSY||!EDIT.record)return;if(!$('reason').value.trim()){$('formerror').textContent='Give a reason before archiving or restoring.';$('formerror').style.display='block';return;}setBusy(true);try{const result=await rpc('tkArchive',{type:EDIT.type,id:EDIT.record.id,token:EDIT.record.token,reason:$('reason').value});$('editor').close();await load();toast(result.warning||'Record status updated.');}catch(e){$('formerror').textContent=e.message;$('formerror').style.display='block';}finally{setBusy(false);}}\ndocument.addEventListener('click',async e=>{const b=e.target.closest('[data-action]');if(!b)return;const {action,type,id}=b.dataset;if(action==='relation')editRelation(type,id);if(action==='nav')go(type);if(action==='new')edit(type,'');if(action==='edit')edit(type,id);if(action==='profile'){PAGE='members';PROFILE=id;READING='';render();}if(action==='read'){PAGE=type;READING=id;PROFILE='';render();}if(action==='chapter'){READING=id;render();}if(action==='back')go(type);if(action==='validate'){try{const result=await rpc('tkValidate');$('validation').innerHTML='<div class=\"notice\">'+(result.issues.length?result.issues.map(esc).join('<br>'):'All '+result.records+' records passed validation.')+'</div>';}catch(err){toast(err.message);}}});\ndocument.addEventListener('input',e=>{if(e.target.id==='search'){const pos=e.target.selectionStart;QUERY=e.target.value;render();$('search').focus();$('search').setSelectionRange(pos,pos);}});document.addEventListener('change',e=>{if(e.target.id==='archived'){INCLUDE_ARCHIVED=e.target.checked;render();}});\n$('form').addEventListener('submit',save);$('archive').onclick=archive;$('close').onclick=$('cancel').onclick=()=>{if(!BUSY)$('editor').close();};$('editor').addEventListener('cancel',e=>{if(BUSY)e.preventDefault();});$('reload').onclick=()=>load();$('refresh').onclick=async()=>{const b=$('refresh');b.disabled=true;try{await rpc('tkRefreshViews');toast('Background tabs hidden. Dashboard and Politics remain visible.');}catch(e){toast(e.message);}finally{b.disabled=false;}};\n// PREVIEW_BOOTSTRAP\nif(window.TK_PREVIEW){$('previewLabel').innerHTML='<div class=\"preview\">LOCAL DESIGN PREVIEW · sample members are fictional and are not installed</div>';}\nload();\nfunction politics(){\n  const entities=DATA.data.clans.filter(x=>!x.archived).map(x=>({...x,name:x.id==='CLN-SELF'?DATA.data.settings[0].name:x.name}));\n  const palette={Unknown:['#e5e7eb','#374151'],Allied:['#285943','#fff'],Friendly:['#b8d8bd','#183b27'],Neutral:['#ece5d3','#514a37'],Rival:['#e8c775','#523b12'],Hostile:['#b65b49','#fff'],War:['#6f252a','#fff']};\n  let html=heading('Politics','Row → column: each cell records one affiliation’s stance toward another. Reverse relations are independent.');\n  html+='<div class=\"actions\">'+btn('new','clans','','Add clan / faction','primary')+btn('nav','clans','','Manage affiliations')+btn('nav','relations','','Manage relations')+'</div><p style=\"margin-top:16px\">Select a relation cell to record or revise a stance. Unknown means no assessment has been recorded.</p>';\n  function matrix(list,external){if(!list.length)return '';return '<div style=\"overflow:auto\"><table><thead><tr><th>From ↓ / toward →</th>'+list.map(x=>'<th>'+esc(x.name)+'</th>').join('')+'</tr></thead><tbody>'+list.map(a=>'<tr><th>'+esc(a.name)+'</th>'+list.map(b=>{if(a.id===b.id)return '<td>—</td>';if(external&&a.kind==='Yautja clan'&&b.kind==='Yautja clan')return '<td>See clans</td>';const r=DATA.data.relations.find(x=>!x.archived&&x.from===a.id&&x.to===b.id),state=r?r.stance:'Unknown',style=palette[state]||palette.Unknown;return '<td style=\"padding:3px\"><button data-action=\"relation\" data-type=\"'+esc(a.id)+'\" data-id=\"'+esc(b.id)+'\" title=\"'+esc(r?r.notes:'No assessment recorded')+'\" style=\"width:100%;min-width:100px;border:0;background:'+style[0]+';color:'+style[1]+'\">'+esc(state)+'</button></td>';}).join('')+'</tr>').join('')+'</tbody></table></div>';}\n  const clans=entities.filter(x=>x.kind==='Yautja clan'),outsiders=entities.filter(x=>x.kind==='Outsider faction');\n  html+='<h2 style=\"margin-top:24px\">Clan relations</h2>'+matrix(clans,false)+'<h2 style=\"margin-top:28px\">Outsider relations</h2>';\n  html+=outsiders.length?matrix(clans.concat(outsiders),true):empty('No outsider factions registered','Add outsiders separately from Yautja clans. No current relations are inferred from the reference.');\n  return html+link('https://docs.google.com/spreadsheets/d/1TVrt1eOLYxJBAVvWxPIDN-cPHHvImN5n2MolWpsTz50/edit','CMU faction relations reference ↗');\n}\nfunction editRelation(from,to){const r=DATA.data.relations.find(x=>!x.archived&&x.from===from&&x.to===to);edit('relations',r?r.id:'');if(!r){$('field-from').value=from;$('field-to').value=to;$('field-name').value=name('clans',from)+' → '+name('clans',to);}}\n\n</script></body></html>\n";}
